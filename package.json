{
  "name": "media-clusterer",
  "version": "4.0.0",
  "description": "Local AI media clusterer with semantic search for photos and videos",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "playwright test --project=cpu",
    "type-check": "tsc --noEmit",
    "deploy": "npm run build && wrangler pages deploy dist --project-name media-clusterer",
    "prepare": "husky",
    "test:gpu": "playwright test --project=phone --project=desktop"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.11.0",
    "@webgpu/types": "^0.1.70",
    "husky": "^9.1.7",
    "selenium-webdriver": "^4.51.0",
    "typescript": "^5.3.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "esbuild": "^0.28.1",
    "ws": "^8.21.0",
    "undici": "^7.30.1",
    "adm-zip": "^0.6.1",
    "sharp": "^0.35.5",
    "postcss": "^8.5.23",
    "nanoid": "^3.3.17"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modernized/exifr": "^8.0.1",
    "@picocss/pico": "^2.1.1",
    "@saehrimnir/druidjs": "^0.8.0",
    "@sentry/browser": "^10.54.0",
    "onnxruntime-web": "^1.26.0",
    "p-limit": "^7.3.0",
    "solid-js": "^1.9.18",
    "vite-plugin-solid": "^2.11.15"
  }
}
